---
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  eyebrow = '',
  title,
  body = '',
  primaryHref = '/contact',
  primaryLabel = 'Start a conversation',
  secondaryHref,
  secondaryLabel
} = Astro.props;
---
<section class="section cta-banner">
  <div class="container">
    {eyebrow && <p class="sec-index">{eyebrow}</p>}
    <h2 class="cta-head" set:html={title}></h2>
    {body && <p class="lede cta-body">{body}</p>}
    <div class="cta-actions">
      <a href={primaryHref} class="btn">{primaryLabel}</a>
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-banner { padding-block: calc(var(--space-section) * 0.9); }
  .cta-head {
    font-size: clamp(2rem, 5.5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    max-width: 24ch;
  }
  .cta-body { color: var(--text-muted); margin-bottom: 2.5rem; }
  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
