---
interface Props {
  items: string[];
}
const { items } = Astro.props;
// Duplicate the list so the scroll loops seamlessly
const doubled = [...items, ...items];
---
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {doubled.map((item) => (
      <span class="marquee-item">{item}</span>
    ))}
  </div>
</div>
