---
import BaseLayout from '../layouts/BaseLayout.astro';
import { openings } from '../data/openings';
---
<BaseLayout
  title="Careers"
  description="Join Sapiogen AI — an AI-first software engineering studio in Ahmedabad. Open roles in engineering and design."
>

  <!-- Page lede -->
  <section class="page-lede">
    <div class="container">
      <p class="sec-index">Careers</p>
      <h1 class="page-title">
        Work with us<span class="dot">.</span>
      </h1>
      <p class="lede">
        We hire for taste, judgement, and the ability to ship — on each of
        which there is no shortcut. If you&rsquo;re tired of teams where AI
        is a sidebar instead of the material, read on.
      </p>
    </div>
  </section>

  <!-- What hiring here looks like - distinct from About's "how studio operates" -->
  <section class="section">
    <div class="container col-split">
      <div class="col-marker"><p class="sec-index">01 — Hiring bar</p></div>
      <div>
        <h2>What we hire for.</h2>
        <div class="hire-grid">
          <article>
            <h3>Ship, not demo</h3>
            <p class="muted">Show us a system you built that is in production. Not a side project that could be in production — one that is, and that someone else uses.</p>
          </article>
          <article>
            <h3>Judgement over opinion</h3>
            <p class="muted">AI engineering is full of trade-offs. We care more about how you think about them than which conclusion you&rsquo;re currently loudest about.</p>
          </article>
          <article>
            <h3>Clear writing</h3>
            <p class="muted">If you can&rsquo;t write it, we can&rsquo;t ship it. Good writing is the fastest signal of thinking we know of.</p>
          </article>
          <article>
            <h3>On-site, Ahmedabad</h3>
            <p class="muted">We work together in the studio. Proximity compounds; we have no plans to grow out of the room.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Compensation and benefits -->
  <section class="section">
    <div class="container col-split">
      <div class="col-marker"><p class="sec-index">02 — Compensation</p></div>
      <div>
        <h2>How we compensate.</h2>
        <p class="lede" style="margin-top: 1.25rem; color: var(--text-muted); max-width: 56ch;">
          Senior talent gets paid like senior talent. Compensation is market-leading
          for Ahmedabad, discussed openly, and reviewed annually.
        </p>
        <ul class="benefits">
          <li><h4>Senior-market cash + meaningful upside</h4><p class="muted">Fair, benchmarked, and reviewed. No games.</p></li>
          <li><h4>Equipment you need to do the work</h4><p class="muted">The machine, the software, the tools — our problem, not yours.</p></li>
          <li><h4>Learning budget</h4><p class="muted">Conferences, courses, books. The field moves; so should you.</p></li>
          <li><h4>Health cover</h4><p class="muted">For you and your immediate family.</p></li>
          <li><h4>Time off that works</h4><p class="muted">Paid leave, flexible around delivery milestones.</p></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Open roles -->
  <section class="section" id="openings">
    <div class="container col-split">
      <div class="col-marker"><p class="sec-index">03 — Open roles</p></div>
      <div>
        <h2>Open roles.</h2>
        <ul class="roles">
          {openings.map((role) => (
            <li class="role">
              <div class="role-head">
                <h3>{role.title}</h3>
                <p class="role-meta muted mono">
                  {role.team} <span class="sep">·</span> {role.location} <span class="sep">·</span> {role.type}
                </p>
              </div>
              <p class="role-summary">{role.summary}</p>
              <a href="#apply" data-role={role.id} class="link-rule apply-link">
                Apply for this role
              </a>
            </li>
          ))}
        </ul>

        <p class="no-role muted">
          Don&rsquo;t see a fit? <a href="#apply" data-role="general" class="link-rule">Send a general application</a> — we read every one.
        </p>
      </div>
    </div>
  </section>

  <!-- Application form -->
  <section class="section" id="apply">
    <div class="container col-split">
      <div class="col-marker"><p class="sec-index">04 — Apply</p></div>
      <div>
        <h2>Apply.</h2>
        <p class="lede" style="margin-top: 1rem; color: var(--text-muted);">
          Tell us who you are and what you have built. We respond to every
          application personally within one week.
        </p>

        <form class="app-form" id="application-form" novalidate>
          <div class="field">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" required autocomplete="name" minlength="2" maxlength="120" />
          </div>

          <div class="row">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email" maxlength="160" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="40" />
            </div>
          </div>

          <div class="field">
            <label for="role">Role</label>
            <select id="role" name="role" required>
              <option value="">Select a role</option>
              {openings.map((r) => <option value={r.id}>{r.title}</option>)}
              <option value="general">General application</option>
            </select>
          </div>

          <div class="row">
            <div class="field">
              <label for="portfolio">Portfolio / GitHub URL</label>
              <input type="url" id="portfolio" name="portfolio" placeholder="https://" maxlength="500" />
            </div>
            <div class="field">
              <label for="linkedin">LinkedIn URL</label>
              <input type="url" id="linkedin" name="linkedin" placeholder="https://linkedin.com/in/..." maxlength="500" />
            </div>
          </div>

          <div class="field">
            <label for="experience">Years of experience</label>
            <input type="number" id="experience" name="experience" min="0" max="60" step="1" />
          </div>

          <div class="field">
            <label for="message">Why Sapiogen AI? Tell us what you have shipped.</label>
            <textarea id="message" name="message" rows="6" required minlength="10" maxlength="4000"></textarea>
          </div>

          <!-- Honeypot — invisible to users, catches bots -->
          <div class="hp-field" aria-hidden="true">
            <label for="website">Website (leave this empty)</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-foot">
            <button type="submit" class="btn" id="submit-btn">Submit application</button>
            <p id="form-status" class="form-status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hire-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 3rem;
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .hire-grid h3 { margin-bottom: 0.75rem; }
  @media (max-width: 760px) {
    .hire-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .benefits {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .benefits h4 { margin-bottom: 0.4rem; font-size: 1.1rem; }
  .benefits p { max-width: 60ch; }

  .roles {
    list-style: none;
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .role {
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .role-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .role-head h3 { font-size: 1.35rem; }
  .role-meta { font-size: 0.78rem; letter-spacing: 0.05em; }
  .sep { opacity: 0.4; margin: 0 0.3rem; }
  .role-summary {
    margin-top: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 60ch;
  }
  .apply-link { display: inline-block; margin-top: 1.25rem; font-size: 0.95rem; }
  .no-role { margin-top: 2rem; font-size: 1rem; }

  .app-form {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 1.75rem;
    max-width: 760px;
  }
</style>

<script>
  const form = document.getElementById('application-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  // Prefill role from "Apply" link
  document.querySelectorAll<HTMLAnchorElement>('[data-role]').forEach((link) => {
    link.addEventListener('click', () => {
      const role = link.dataset.role;
      const select = document.getElementById('role') as HTMLSelectElement | null;
      if (role && select) select.value = role;
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !submitBtn) return;

    const data = Object.fromEntries(new FormData(form).entries());
    status.textContent = 'Submitting…';
    status.className = 'form-status';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/careers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.message || 'Submission failed');
      window.location.href = '/thank-you?kind=application';
    } catch (err: any) {
      status.textContent = err.message || 'Something went wrong. Please try again or email hello@sapiogenai.com.';
      status.className = 'form-status error';
      submitBtn.disabled = false;
    }
  });
</script>
