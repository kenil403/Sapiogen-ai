---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { caseStudies } from '../data/caseStudies';
---
<BaseLayout
  title="Work"
  description="Representative case studies — AI systems Sapiogen AI has shipped across financial services, logistics, SaaS, and enterprise."
>

  <!-- Page lede -->
  <section class="page-lede">
    <div class="container">
      <p class="sec-index">Work</p>
      <h1 class="page-title">
        Systems we&rsquo;ve shipped<span class="dot">.</span>
      </h1>
      <p class="lede">
        A selection of representative engagements. Client names and specific
        metrics are redacted here; we&rsquo;ll walk you through the full
        picture when we talk.
      </p>
    </div>
  </section>

  <!-- Case studies list -->
  <section class="section">
    <div class="container">
      <ul class="case-list">
        {caseStudies.map((cs, i) => (
          <li class="case" id={cs.id}>
            <div class="case-head">
              <span class="mono case-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="case-meta">
                <span class="mono case-sector">{cs.sector}</span>
                <span class="mono case-year dim">{cs.year}</span>
              </div>
            </div>

            <h2 class="case-title">{cs.title}</h2>
            <p class="case-summary">{cs.summary}</p>

            <div class="case-footer">
              <div class="case-outcome">
                <h4 class="case-section-title">Outcome</h4>
                <p>{cs.outcome}</p>
              </div>
              <div class="case-stack">
                <h4 class="case-section-title">Stack</h4>
                <ul class="stack-list">
                  {cs.stack.map((s) => <li class="mono">{s}</li>)}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Industries we serve -->
  <section class="section">
    <div class="container col-split">
      <div class="col-marker"><p class="sec-index">Reach</p></div>
      <div>
        <h2>Who we work with.</h2>
        <p class="lede" style="margin-top: 1.25rem; color: var(--text-muted);">
          We engineer AI-first systems for startups and modern enterprises
          across sectors where intelligence has real work to do.
        </p>
        <ul class="sectors">
          <li>Financial services &amp; fintech</li>
          <li>Logistics &amp; operations</li>
          <li>B2B SaaS</li>
          <li>Enterprise software</li>
          <li>Healthcare &amp; life sciences</li>
          <li>Legal &amp; professional services</li>
          <li>Media &amp; content</li>
          <li>Retail &amp; e-commerce</li>
        </ul>
      </div>
    </div>
  </section>

  <CTABanner
    title="Could the next one<br/>be yours?"
    body="If one of these engagements maps to a problem you&rsquo;re solving, we should talk."
    primaryLabel="Start a conversation"
    secondaryHref="/services"
    secondaryLabel="See disciplines"
  />

</BaseLayout>

<style>
  .case-list {
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .case {
    padding-block: 3rem;
    border-bottom: 1px solid var(--rule);
  }
  .case-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .case-num {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
  }
  .case-meta {
    display: inline-flex;
    gap: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .case-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    max-width: 22ch;
    margin-bottom: 1rem;
  }
  .case-summary {
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 64ch;
    font-size: 1.05rem;
  }
  .case-footer {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .case-section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .case-outcome p { max-width: 50ch; color: var(--text); }
  .stack-list { list-style: none; display: grid; gap: 0.4rem; }
  .stack-list li { font-size: 0.9rem; color: var(--text-muted); }
  @media (max-width: 760px) {
    .case-footer { grid-template-columns: 1fr; gap: 2rem; }
  }

  .sectors {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .sectors li {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .sectors { grid-template-columns: 1fr; }
  }
</style>
