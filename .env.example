# Site
PUBLIC_SITE_URL=https://sapiogenai.com
HOST=0.0.0.0
PORT=4321
NODE_ENV=production

# MongoDB Atlas — REQUIRED. Replace with your Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of allowed origins for API routes (CORS).
# For same-origin production usage you can leave only the production domain.
ALLOWED_ORIGINS=https://sapiogenai.com,https://www.sapiogenai.com

# Optional notification inbox (used by the API handlers as a BCC/notify target)
NOTIFY_EMAIL=hello@sapiogenai.com

# Admin API protection — a long random string.
# Required to call GET /api/admin/* endpoints. Generate with: openssl rand -hex 32
ADMIN_TOKEN=